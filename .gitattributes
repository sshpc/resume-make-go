# 统一换行符，避免 Windows 上检出成 CRLF 后 gofmt 判定文件未格式化
* text=auto eol=lf

*.go   text eol=lf
*.mod  text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf

# Windows 批处理必须是 CRLF，否则部分系统上会解析异常
*.bat  text eol=crlf

# 二进制文件不做行尾转换
*.exe  binary
*.png  binary
*.jpg  binary
*.pdf  binary
